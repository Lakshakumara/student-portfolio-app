# Email Notification Configuration (Optional)
# If left blank, contact submissions are automatically forwarded to ynadewmini@gmail.com
# via the free FormSubmit gateway and logged locally in app/contact_messages.json.

# To use direct Gmail SMTP delivery:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate an "App Password" (myaccount.google.com/apppasswords)
# 3. Fill in the credentials below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ynadewmini@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
